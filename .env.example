APP_NAME=KartuKita
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_TIMEZONE=Asia/Jakarta
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# KartuKita
KARTUKITA_SUPPORT_WHATSAPP=
KARTUKITA_DRAFT_RETENTION_DAYS=30
KARTUKITA_PREVIEW_TTL_HOURS=24
KARTUKITA_MEDIA_DISK=local
KARTUKITA_SERVICE_FEE=0

# Pembayaran QRIS otomatis (InterActive QRIS). API key & mID dikirim InterActive setelah PKS/NDA.
# Webhook: daftarkan URL https://<domain>/webhook/qris/<QRIS_INTERACTIVE_WEBHOOK_TOKEN> di InterActive.
# QRIS_DRIVER=fake hanya untuk pengembangan lokal (tombol simulasi bayar; diabaikan di produksi).
QRIS_DRIVER=interactive
QRIS_INTERACTIVE_API_KEY=
QRIS_INTERACTIVE_MID=
QRIS_INTERACTIVE_WEBHOOK_TOKEN=

# Selama API QRIS belum aktif: KARTUKITA_PAYMENT_MODE=manual memakai QRIS statis merchant.
# Letakkan gambar QRIS statis di public/images/qris-statis.jpg (atau atur path-nya di bawah).
# Pembeli membayar nominal unik lalu mengunggah bukti bayar; admin dapat notifikasi (bukti dikirim ke Telegram) & tinggal Konfirmasi.
KARTUKITA_PAYMENT_MODE=qris
KARTUKITA_MANUAL_QRIS_IMAGE=images/qris-statis.jpg
KARTUKITA_MANUAL_MERCHANT_NAME="VERITAS WEB DEVELOPER"
# `upload` = bukti diunggah di web; `whatsapp` = bukti dikirim ke KARTUKITA_SUPPORT_WHATSAPP.
KARTUKITA_MANUAL_PROOF_CHANNEL=upload

# Notifikasi admin via Telegram (opsional): token dari @BotFather, chat_id dari /getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Tombol "Sudah bayar / Belum" di Telegram: di lokal jalankan `php artisan kartukita:telegram-poll`;
# di produksi (https) isi rahasia acak ini lalu jalankan `php artisan kartukita:telegram-webhook`.
TELEGRAM_WEBHOOK_SECRET=

# Peta Jejak Kenangan: identitas untuk Nominatim (wajib nama aplikasi + kontak asli).
KARTUKITA_GEOCODER_USER_AGENT=
KARTUKITA_MAP_TILE_URL=
KARTUKITA_MAP_ATTRIBUTION=

# Pencarian lagu Spotify untuk komponen Lagu Kita (opsional; tanpa ini pengirim tetap bisa tempel link).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
